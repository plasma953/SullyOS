# ─────────────────────────────────────────────────────────────
# SullyOS VPS 后端 · 环境变量模板
# 真实密钥只存在于 VPS 的 /opt/sullyos/.env（chmod 600），永不入库。
# ─────────────────────────────────────────────────────────────

# 监听地址：所有服务只监听本机回环，由 Caddy 反代暴露 80/443
HOST=127.0.0.1

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ── instant-push（8831）──────────────────────────────────────
# Web Push VAPID 密钥对（生成：node bin/gen-vapid.js）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=amsg@sullyos.local
# 客户端调用令牌（前端 X-Client-Token / Authorization 校验）
AMSG_CLIENT_TOKEN=
# 大 payload 传输策略：multipart（默认，无需 DB）| d1 | auto
AMSG_OVERSIZE_TRANSPORT=multipart

# ── amsg（8832）──────────────────────────────────────────────
# 定时消息 AES-GCM 主密钥（SHA-256 派生加密 Key）
AMSG_SECRET_KEY=
AMSG_DB_PATH=/opt/sullyos/data/amsg.sqlite
# ── proactive-push（8833）────────────────────────────────────
# Worker 内部校验令牌（留空=不校验；建议与 AMSG_CLIENT_TOKEN 同值）
CLIENT_TOKEN=
# VAPID 主题（mailto:），Worker 生成 JWT 时使用
VAPID_SUBJECT=
# 心跳窗口毫秒数（默认 300000）
HEARTBEAT_WINDOW_MS=300000

# ── 主代理（8830）· LLM（OpenAI 兼容，可多供应商 fallback）──
# 与 SullyOS App 内「API 预设」字段一一对应，可直接把 App 里的预设抄到这里。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# fallback 供应商（JSON 数组，按顺序尝试）
# 例：[{"baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-...","model":"deepseek-chat"}]
LLM_FALLBACKS=
LLM_TIMEOUT_MS=120000

# MCP 会话循环：单轮工具调用上限（原 MAX_LOOPS=6 的配置化）
MCP_MAX_LOOPS=12
# MCP 工具服务器（JSON 数组，streamable HTTP）：
# [{"name":"xhs-mcp","url":"http://127.0.0.1:8810/mcp"},
#  {"name":"kaleidoscope-rp","url":"http://127.0.0.1:8788/mcp","token":"..."}]
MCP_SERVERS=
# 钉住工具：逗号分隔的工具名，从第 2 轮 MCP 循环起始终携带（参考类工具）
MCP_PINNED_TOOLS=

# ── 备份（双通道）────────────────────────────────────────────
# GitHub 通道（私有仓，VACUUM INTO 快照 → 打包 → 推送）
GITHUB_PAT=
GITHUB_BACKUP_REPO=
BACKUP_KEEP=7
BACKUP_ENCRYPT_PASSPHRASE=
# WebDAV 通道（dufs，仅本机；主代理 /webdav 中转并注入认证）
DUFS_PORT=8890
DUFS_AUTH=
DUFS_ROOT=/opt/sullyos/backups/webdav

# ── 部署（install.sh 使用）──────────────────────────────────
SULLYOS_DOMAIN=
ACME_EMAIL=
