# SullyOS VPS · Caddy 反代配置
# 安装时由 deploy/scripts/install.sh 用 sed 替换 ${SULLYOS_DOMAIN} / ${ACME_EMAIL}。
# 所有后端仅监听 127.0.0.1；这里只暴露 80/443（自动 HTTPS）。
#
# 前端（Vercel）按路径访问：
#   /instant-push/* → 8831   /amsg/* → 8832        /proactive-push/* → 8833
#   /agent/*        → 8830   /wake-bridge/* → 8834  /heartbeat/* → 8835
#   /webdav/*       → dufs 8890（备份直连，主代理负责注入认证）

{
	email ${ACME_EMAIL}
	admin off
}

${SULLYOS_DOMAIN} {
	encode gzip zstd

	# ── 主代理（LLM + MCP）──────────────────────────────
	handle /agent/* {
		uri strip_prefix /agent
		reverse_proxy 127.0.0.1:8830 {
			flush_interval -1
		}
	}

	# ── instant-push（Web Push）─────────────────────────
	handle /instant-push/* {
		uri strip_prefix /instant-push
		reverse_proxy 127.0.0.1:8831
	}

	# ── amsg 定时消息 ───────────────────────────────────
	handle /amsg/* {
		uri strip_prefix /amsg
		reverse_proxy 127.0.0.1:8832
	}

	# ── proactive-push ──────────────────────────────────
	handle /proactive-push/* {
		uri strip_prefix /proactive-push
		reverse_proxy 127.0.0.1:8833
	}

	# ── 唤醒桥 ──────────────────────────────────────────
	handle /wake-bridge/* {
		uri strip_prefix /wake-bridge
		reverse_proxy 127.0.0.1:8834
	}

	# ── 心跳 ────────────────────────────────────────────
	handle /heartbeat/* {
		uri strip_prefix /heartbeat
		reverse_proxy 127.0.0.1:8835
	}

	# ── 备份 WebDAV（dufs；主代理中转并注入 DUFS_AUTH）──
	handle /webdav/* {
		reverse_proxy 127.0.0.1:8890
	}

	# 兜底：503（后端未就绪时明确报错，不暴露目录）
	handle {
		respond "SullyOS backend route not found" 404
	}
}