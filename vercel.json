{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agent/:path*",
      "destination": "/api/backend-proxy?ns=agent&rest=:path*"
    },
    {
      "source": "/amsg/:path*",
      "destination": "/api/backend-proxy?ns=amsg&rest=:path*"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
