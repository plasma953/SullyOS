VITE_AMSG_NATIVE_PUSH=true
# amsg worker 默认地址：填到 Caddy 的 /amsg 前缀（handle_path 剥前缀后 8832 收到
# 根路径端点，ReiClient 拼的是 ${baseUrl}/schedule-message 等）。不带 /amsg 后缀会 404。
# 仅作「用户未填时」的兜底，设置里填过的值优先。
VITE_AMSG_DEFAULT_WORKER_URL=https://43451695.xyz/amsg
# fork 自用：不检查上游 OTA（出包用本仓库 Actions，指向上游清单只会误报「有更新」）
VITE_APK_UPDATE_MANIFEST_URL=
VITE_HIDE_BUILD_BADGE=1
